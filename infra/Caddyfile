{$APP_ADDRESS:http://localhost} {
  encode zstd gzip

  handle /api/* {
    reverse_proxy api:3000
  }

  handle /docs* {
    reverse_proxy api:3000
  }

  handle /mcp* {
    reverse_proxy mcp:3100 {
      header_up Host mcp
    }
  }

  handle /socket.io/* {
    reverse_proxy api:3000
  }

  handle /webhooks/mailgun {
    reverse_proxy api:3000
  }

  handle {
    reverse_proxy web:80
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options SAMEORIGIN
    Referrer-Policy strict-origin-when-cross-origin
    Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  }
}

# Ponte HTTP local para o Tailscale Funnel entregar mídias do MinIO sem
# publicar diretamente o armazenamento na rede do servidor.
:9002 {
  reverse_proxy minio:9000
}
