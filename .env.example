NODE_ENV=development
TZ=America/Sao_Paulo
# Desenvolvimento local. Na produção, substitua pelo domínio público com HTTPS.
APP_URL=http://localhost:5173
APP_ADDRESS=http://localhost
API_URL=http://localhost:5173/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
VITE_ALLOWED_HOSTS=
PORT=3000
HOST=::
COOKIE_SECURE=false
# Servidor MCP para integrações com LLMs. Em produção o Docker sobrescreve
# MCP_HOST e MCP_API_URL e publica o endpoint em APP_ADDRESS/mcp via Caddy.
MCP_HOST=127.0.0.1
MCP_PORT=3100
MCP_API_URL=http://localhost:3000/api/v1
MCP_API_TIMEOUT_MS=15000
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
MCP_ALLOWED_ORIGINS=localhost,127.0.0.1,[::1]
VITE_MCP_URL=http://localhost:3100/mcp
# Consulta pública usada para preencher o cadastro de empresas pelo CNPJ.
CNPJ_LOOKUP_API_URL=https://brasilapi.com.br/api/cnpj/v1
POSTGRES_DB=prospecta
POSTGRES_USER=prospecta
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql://prospecta:troque-esta-senha@localhost:5434/prospecta?schema=public
REDIS_URL=redis://localhost:6380
SESSION_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
JWT_SECRET=troque-por-uma-chave-jwt-com-pelo-menos-32-caracteres
CSRF_SECRET=troque-por-outra-chave-com-pelo-menos-32-caracteres
ENCRYPTION_KEY=troque-por-32-bytes-em-base64
EVOLUTION_BIND_PORT=8082
EVOLUTION_API_URL=http://localhost:8082
# No desenvolvimento local, a Evolution em Docker alcança a API por este endereço.
# O docker-compose.yml sobrescreve para http://api:3000 em produção.
API_INTERNAL_URL=http://host.docker.internal:3000
EVOLUTION_API_KEY=troque-a-chave-da-evolution
EVOLUTION_WEBHOOK_SECRET=troque-o-segredo-do-webhook
# Mailgun: use uma Domain Sending Key (ou a Private API Key), nunca uma chave pública.
MAILGUN_API_KEY=troque-pela-chave-de-envio-do-mailgun
MAILGUN_DOMAIN=mg.seudominio.com.br
MAILGUN_FROM_EMAIL=contato@mg.seudominio.com.br
MAILGUN_FROM_NAME=BZS Tecnologia
# Gmail usado exclusivamente pelas campanhas de e-mail criadas manualmente.
# Ative a verificação em duas etapas e use uma senha de app, nunca a senha da conta.
CAMPAIGN_GMAIL_USER=campanhas@gmail.com
CAMPAIGN_GMAIL_APP_PASSWORD=cole-a-senha-de-app-de-16-caracteres
CAMPAIGN_GMAIL_FROM_NAME=BZS Tecnologia
# Use US para domínios criados na região americana ou EU para domínios europeus.
MAILGUN_REGION=US
# Copie em Mailgun > Settings > API Security > Webhook signing key.
MAILGUN_WEBHOOK_SIGNING_KEY=troque-pela-chave-de-assinatura-dos-webhooks
# Aceita atrasos normais de entrega do webhook, rejeitando requisições antigas.
MAILGUN_WEBHOOK_TOLERANCE_SECONDS=3600
S3_ENDPOINT=http://localhost:9000
# Endereço que o navegador local usará para enviar e baixar mídias.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_BIND_ADDRESS=0.0.0.0
# URL usada nas mídias entregues à Evolution. Precisa ser alcançável pelo contêiner e ter hostname válido.
S3_DELIVERY_ENDPOINT=http://host.docker.internal:9000
# No Docker Compose de produção, use o alias interno configurado abaixo.
S3_DELIVERY_ENDPOINT_DOCKER=http://minio.local:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=prospecta
S3_SECRET_KEY=prospecta-secret
S3_BUCKET=prospecta-media
EVOLUTION_CUSTOM_IMAGE=bzs-one/evolution-api:2.3.7-link-preview
EVOLUTION_SOURCE_REF=cd800f2976e1e5b682fbf86a01ee4d85ae61f370
EVOLUTION_POSTGRES_DB=evolution
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=troque-esta-senha-evolution
EVOLUTION_PUBLIC_URL=http://evolution:8080
EVOLUTION_LOG_LEVEL=ERROR,WARN
MEDIA_PROCESSING_CONCURRENCY=1
# Transcrição local e gratuita com Speaches/faster-whisper.
TRANSCRIPTION_API_URL=http://localhost:8000/v1/audio/transcriptions
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_MODEL=Systran/faster-whisper-small
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_TIMEOUT_MS=120000
TRANSCRIPTION_MODEL_DOWNLOAD_TIMEOUT_MS=600000
TRANSCRIPTION_MAX_BYTES=26214400
TRANSCRIPTION_CONCURRENCY=1
TRANSCRIPTION_BIND_PORT=8000
TRANSCRIPTION_CPU_THREADS=4
SPEACHES_IMAGE=ghcr.io/speaches-ai/speaches:latest-cpu
EVOLUTION_S3_ACCESS_KEY=evolution
EVOLUTION_S3_SECRET_KEY=troque-esta-senha-evolution-s3
BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=troque-por-uma-chave-de-backup
# URLs relativas fazem cada navegador chamar o servidor que abriu a página,
# em vez de tentar acessar o localhost do próprio computador.
VITE_API_URL=/api/v1
VITE_SOCKET_URL=/
