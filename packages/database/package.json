{
  "name": "@prospecta/database",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node --env-file-if-exists=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts",
    "db:backfill:activities": "node --env-file-if-exists=../../.env --import tsx prisma/backfill-activities.ts",
    "setup:homologation": "node --env-file-if-exists=../../.env --import tsx prisma/setup-homologation.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.11.0",
    "argon2": "^0.41.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^6.11.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
