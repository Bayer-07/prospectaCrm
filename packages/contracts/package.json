{
  "name": "@prospecta/contracts",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./whatsapp-contact": {
      "types": "./dist/whatsapp-contact.d.ts",
      "import": "./dist/whatsapp-contact.js"
    },
